# Gemini API (already required by the app)
GEMINI_API_KEY=

# Firebase config — get these from Firebase Console > Project Settings > General > Your apps > Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Phone alerts for new enquiries (Firebase Console > Project settings > Cloud Messaging > Web Push certificates > Generate key pair)
FIREBASE_VAPID_KEY=
# Where the website lives (it sends the alerts). Defaults to https://www.techinfigo.com
WEBSITE_URL=
